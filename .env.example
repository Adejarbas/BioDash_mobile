# ==============================================================================
# BIODASH MOBILE / WEB (EXPO) - ENV EXAMPLE
# ==============================================================================
# Copie este arquivo para .env e preencha com suas configurações locais.
# NUNCA coloque chaves secretas de infraestrutura ou produção neste arquivo.

# ------------------------------------------------------------------------------
# CONEXÃO COM O BACKEND (BioDashBD)
# ------------------------------------------------------------------------------
# Em desenvolvimento web local no navegador (padrão):
EXPO_PUBLIC_API_URL=http://localhost:3003
# Em celular físico rodando Expo Go (mesma rede Wi-Fi, substitua pelo IP da máquina):
# EXPO_PUBLIC_API_URL=http://192.168.1.X:3003
# Em produção (Azure Container Apps):
# EXPO_PUBLIC_API_URL=https://ca-biodash-api-prod.victoriousmoss-60cc301a.chilecentral.azurecontainerapps.io/api

# ------------------------------------------------------------------------------
# SUPABASE (Autenticação e dados de clientes)
# ------------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua_chave_anonima_publica_aqui
