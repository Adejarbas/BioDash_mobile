# Copie este arquivo para .env e preencha com suas credenciais reais.
# NUNCA coloque valores reais aqui — este arquivo vai para o git.

# Supabase (Supabase > Settings > API)
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua_chave_anon_aqui

# Backend. Sem estas linhas, usa o servidor de producao.
# Em celular fisico, troque localhost pelo IP do PC.
EXPO_PUBLIC_API_URL=http://localhost:3003/api
EXPO_PUBLIC_NEXT_API_URL=http://localhost:3003/api
