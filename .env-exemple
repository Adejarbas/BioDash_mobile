# ==============================================================================
# BIODASH MOBILE / WEB (EXPO) - ENV EXAMPLE
# ==============================================================================
# Copie este arquivo para .env e preencha com suas credenciais reais.
# NUNCA coloque valores de segredos reais aqui — este arquivo vai para o git.

# ------------------------------------------------------------------------------
# 🔷 NECESSÁRIAS PARA O AZURE (INTEGRAÇÃO COM O BACKEND)
# ------------------------------------------------------------------------------
# NOTA DE ARQUITETURA E SEGURANÇA:
# O frontend NÃO precisa de chaves da Azure (Connection String, Account Key, etc.).
# As credenciais da Azure ficam 100% protegidas dentro do Backend (BioDashBD).
# O mobile apenas precisa do endereço da API do Backend, que gera os SAS Tokens:
#
# Em desenvolvimento local:
EXPO_PUBLIC_API_URL=http://localhost:3003/api
# Em celular físico (mesma rede Wi-Fi, substitua pelo IP da máquina):
# EXPO_PUBLIC_API_URL=http://192.168.1.X:3003/api
# Em produção (quando o backend estiver rodando no Azure Container Apps):
# EXPO_PUBLIC_API_URL=https://biodash-backend.<regiao>.azurecontainerapps.io/api

# ------------------------------------------------------------------------------
# SERVIÇOS AUXILIARES
# ------------------------------------------------------------------------------
# Supabase Auth
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua_chave_anon_aqui
