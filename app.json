{
  "expo": {
    "name": "BioDash Mobile",
    "slug": "biodash-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Permitir que o BioDash acesse o microfone para reconhecimento de voz.",
          "speechRecognitionPermission": "Permitir que o BioDash use o reconhecimento de voz para transcrever suas mensagens."
        }
      ]
    ]
  }
}